#!/usr/bin/env bash
# Sonos4Lox cron.01min
# Version: CRON_CHECKSTATE_TIMER_FALLBACK_V01_2026_11_04
# Runs as user "loxberry".
set -euo pipefail

CFG="REPLACELBPCONFIGDIR/s4lox_config.json"
if [[ ! -f "$CFG" ]]; then
    echo "Config not found: $CFG" >&2
    exit 0
fi

# The systemd timer is the primary scheduler for CheckState.php. Cron provides
# a fallback when that timer is inactive; CheckState's lock prevents overlaps.
if ! command -v systemctl >/dev/null 2>&1 || ! systemctl is-active --quiet sonos_check_on_state.timer; then
    /usr/bin/php REPLACELBPHTMLDIR/src/Core/Runtime/CheckState.php >/dev/null 2>&1 &
fi

# Preserve the original per-minute enforcement cycle (10-second cadence).
i=0
while [[ $i -lt 6 ]]; do
    sleep 2
    /usr/bin/php REPLACELBPHTMLDIR/src/Support/MaxVolumeEnforcer.php &
    sleep 2
    /usr/bin/php REPLACELBPHTMLDIR/src/Support/TvMonitor.php run &
    sleep 2
    /usr/bin/php REPLACELBPHTMLDIR/src/Support/TimeRestrictionEnforcer.php &
    sleep 4
    i=$((i + 1))
done
